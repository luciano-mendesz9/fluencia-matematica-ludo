# Runtime pooled URL for the same isolated Neon branch as DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@EP-NAME-pooler.REGION.aws.neon.tech/fluencia_dev?sslmode=require"

# Direct URL used only by Prisma CLI and guarded database scripts.
DIRECT_URL="postgresql://USER:PASSWORD@EP-NAME.REGION.aws.neon.tech/fluencia_dev?sslmode=require"

# Must match the dedicated marker schema provisioned outside public.
# Allowed in development commands: fluencia-matematica-development, -test or -e2e.
APP_ENV_ID="fluencia-matematica-development"

# At least 32 random bytes. Never expose this value with NEXT_PUBLIC_*.
AUTH_JWT_SECRET="replace-with-at-least-32-random-bytes"

# Use 12 or more in production after measuring the deployment runtime.
BCRYPT_ROUNDS="12"

# Keep true outside local plain-HTTP development and tests.
AUTH_COOKIE_SECURE="true"
