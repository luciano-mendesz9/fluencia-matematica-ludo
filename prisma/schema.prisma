generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum GlobalRole {
  SEMED_ADMIN
  DEVELOPER
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
}

enum SchoolMembershipRole {
  COORDINATOR
  TEACHER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

enum AcademicYearStatus {
  ACTIVE
  INACTIVE
}

enum ClassGroupStatus {
  ACTIVE
  INACTIVE
}

enum EnrollmentStatus {
  ACTIVE
  ENDED
}

enum TeacherAssignmentStatus {
  ACTIVE
  ENDED
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum QuestionOrigin {
  SEMED
  PRIVATE
}

enum QuestionStatus {
  ACTIVE
  ARCHIVED
}

enum QuestionAnswerType {
  MULTIPLE_CHOICE
  NUMERIC
}

enum QuestionMediaKind {
  IMAGE
}

enum QuestionSubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  REJECTED
  APPROVED_PUBLISHED
}

enum ActivityStatus {
  DRAFT
  OPEN
  CLOSED
}

enum AcceptedAnswerOutcome {
  CORRECT
  INCORRECT
}

enum GameSessionStatus {
  ACTIVE
  SUSPENDED
  FINISHED
}

enum GamePhase {
  WAITING_FIRST_EXIT
  STUDENT_ROLL
  CHALLENGE_PENDING
  MOVE_PENDING
  RECOVERY_ROLL
  RECOVERY_RELEASE
  FINISHED
}

enum GameTurn {
  STUDENT
  MACHINE
}

enum GameActionType {
  ROLL
}

enum ChallengeStatus {
  PENDING
  ANSWERED
  CANCELLED
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  name            String       @db.VarChar(160)
  email           String?      @db.VarChar(320)
  normalizedEmail String?      @unique @db.VarChar(320)
  studentCode     String?      @unique @db.VarChar(80)
  passwordHash    String       @db.VarChar(255)
  status          UserStatus   @default(ACTIVE)
  globalRole      GlobalRole?
  sessionVersion  Int          @default(1)
  revision        Int          @default(1)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  sessions        Session[]
  auditEvents     AuditEvent[] @relation("AuditActor")
  passwordResets  PasswordReset[] @relation("PasswordResetUser")
  requestedResets PasswordReset[] @relation("PasswordResetRequester")
  schoolMemberships SchoolMembership[]
  enrollments      Enrollment[]
  teacherAssignments TeacherClassAssignment[]
  ownedQuestions      Question[]        @relation("QuestionOwner")
  createdQuestions    Question[]        @relation("QuestionCreator")
  questionVersions    QuestionVersion[] @relation("QuestionVersionAuthor")
  questionSubmissions QuestionSubmission[] @relation("QuestionSubmitter")
  questionReviews     QuestionSubmission[] @relation("QuestionReviewer")
  createdActivities   Activity[] @relation("ActivityTeacher")
  activityParticipations ActivityParticipation[] @relation("ActivityStudent")

  @@index([status])
}

model School {
  id            String             @id @default(uuid()) @db.Uuid
  name          String             @db.VarChar(160)
  externalCode  String?            @unique @db.VarChar(80)
  status        SchoolStatus       @default(ACTIVE)
  revision      Int                @default(1)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)
  memberships   SchoolMembership[]
  academicYears AcademicYear[]
  classGroups   ClassGroup[]
  enrollments   Enrollment[]
  teacherAssignments TeacherClassAssignment[]
  activities     Activity[]

  @@index([status, name])
}

model AcademicYear {
  id          String             @id @default(uuid()) @db.Uuid
  schoolId    String             @db.Uuid
  year        Int
  status      AcademicYearStatus @default(ACTIVE)
  revision    Int                @default(1)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classGroups ClassGroup[]

  @@unique([schoolId, year])
  @@unique([id, schoolId])
  @@index([schoolId, status, year])
}

model ClassGroup {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @db.Uuid
  academicYearId String           @db.Uuid
  grade          Int
  name           String           @db.VarChar(120)
  normalizedName String           @db.VarChar(120)
  status         ClassGroupStatus @default(ACTIVE)
  revision       Int              @default(1)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear     @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  enrollments    Enrollment[]
  teacherAssignments TeacherClassAssignment[]
  activities       Activity[]

  @@unique([id, schoolId])
  @@unique([schoolId, academicYearId, normalizedName])
  @@index([schoolId, status, academicYearId, grade, name])
}

model Enrollment {
  id        String           @id @default(uuid()) @db.Uuid
  studentId String           @db.Uuid
  schoolId  String           @db.Uuid
  classId   String           @db.Uuid
  status    EnrollmentStatus @default(ACTIVE)
  startsAt  DateTime         @default(now()) @db.Timestamptz(3)
  endsAt    DateTime?        @db.Timestamptz(3)
  revision  Int              @default(1)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  student   User             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classGroup ClassGroup      @relation(fields: [classId, schoolId], references: [id, schoolId], onDelete: Restrict)
  activityParticipations ActivityParticipation[]

  @@index([studentId, status, startsAt, endsAt])
  @@index([schoolId, status, classId, startsAt])
}

model SchoolMembership {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  schoolId  String               @db.Uuid
  role      SchoolMembershipRole
  status    MembershipStatus     @default(ACTIVE)
  startsAt  DateTime             @default(now()) @db.Timestamptz(3)
  endsAt    DateTime?            @db.Timestamptz(3)
  revision  Int                  @default(1)
  createdAt DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt DateTime             @updatedAt @db.Timestamptz(3)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  teacherAssignments TeacherClassAssignment[]

  @@unique([id, userId, schoolId])
  @@index([userId, status, startsAt, endsAt])
  @@index([schoolId, role, status])
}

model TeacherClassAssignment {
  id           String                  @id @default(uuid()) @db.Uuid
  membershipId String                  @db.Uuid
  teacherId    String                  @db.Uuid
  schoolId     String                  @db.Uuid
  classId      String                  @db.Uuid
  status       TeacherAssignmentStatus @default(ACTIVE)
  startsAt     DateTime                @default(now()) @db.Timestamptz(3)
  endsAt       DateTime?               @db.Timestamptz(3)
  revision     Int                     @default(1)
  createdAt    DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @db.Timestamptz(3)
  membership   SchoolMembership        @relation(fields: [membershipId, teacherId, schoolId], references: [id, userId, schoolId], onDelete: Restrict)
  teacher      User                    @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  school       School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classGroup   ClassGroup              @relation(fields: [classId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@index([teacherId, schoolId, status, startsAt, endsAt])
  @@index([schoolId, classId, status])
  @@index([membershipId, status])
}

model PasswordReset {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  expiresAt     DateTime  @db.Timestamptz(3)
  usedAt        DateTime? @db.Timestamptz(3)
  requestedById String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  user          User      @relation("PasswordResetUser", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy   User?     @relation("PasswordResetRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([requestedById, createdAt])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  requestId  String    @unique @db.Uuid
  tokenHash  String    @unique @db.VarChar(128)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  lastSeenAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model LoginThrottle {
  id           String    @id @default(uuid()) @db.Uuid
  keyHash      String    @unique @db.Char(64)
  failureCount Int       @default(0)
  blockedUntil DateTime? @db.Timestamptz(3)
  firstFailedAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  @@index([blockedUntil])
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @db.Uuid
  action        String   @db.VarChar(120)
  targetType    String   @db.VarChar(120)
  targetId      String?  @db.VarChar(160)
  schoolId      String?  @db.Uuid
  before        Json?    @db.JsonB
  after         Json?    @db.JsonB
  correlationId String   @db.VarChar(120)
  at            DateTime @default(now()) @db.Timestamptz(3)
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, at])
  @@index([targetType, targetId, at])
  @@index([correlationId])
}

model Theme {
  id             String        @id @default(uuid()) @db.Uuid
  name           String        @db.VarChar(120)
  normalizedName String        @unique @db.VarChar(120)
  status         CatalogStatus @default(ACTIVE)
  revision       Int           @default(1)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  skills         Skill[]
  versions       QuestionVersion[]

  @@index([status, name])
}

model Skill {
  id             String        @id @default(uuid()) @db.Uuid
  themeId        String        @db.Uuid
  name           String        @db.VarChar(160)
  normalizedName String        @db.VarChar(160)
  status         CatalogStatus @default(ACTIVE)
  revision       Int           @default(1)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  theme          Theme         @relation(fields: [themeId], references: [id], onDelete: Restrict)
  versions       QuestionVersion[]

  @@unique([themeId, normalizedName])
  @@unique([id, themeId])
  @@index([themeId, status, name])
}

model Question {
  id                  String         @id @default(uuid()) @db.Uuid
  origin              QuestionOrigin
  ownerId             String?        @db.Uuid
  createdById         String         @db.Uuid
  sourceQuestionId    String?        @db.Uuid
  sourceVersionId     String?        @db.Uuid
  status              QuestionStatus @default(ACTIVE)
  revision            Int            @default(1)
  latestVersionNumber Int            @default(1)
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)
  owner               User?          @relation("QuestionOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy           User           @relation("QuestionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sourceQuestion      Question?      @relation("PublishedQuestionSource", fields: [sourceQuestionId], references: [id], onDelete: Restrict)
  publishedCopies     Question[]     @relation("PublishedQuestionSource")
  sourceVersion       QuestionVersion? @relation("PublishedVersionSource", fields: [sourceVersionId], references: [id], onDelete: Restrict)
  publicationSubmissions QuestionSubmission[] @relation("SubmissionPublishedQuestion")
  versions            QuestionVersion[]

  @@index([origin, status])
  @@index([ownerId, status])
  @@index([sourceQuestionId, sourceVersionId])
}

model QuestionVersion {
  id            String   @id @default(uuid()) @db.Uuid
  questionId    String   @db.Uuid
  versionNumber Int
  grade         Int
  difficulty    Int
  themeId       String   @db.Uuid
  skillId       String?  @db.Uuid
  statement     String   @db.Text
  answerType    QuestionAnswerType?
  explanation   String?  @db.Text
  numericExpected Decimal? @db.Decimal(18, 6)
  contentHash   String   @db.Char(64)
  createdById   String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  question      Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  theme         Theme    @relation(fields: [themeId], references: [id], onDelete: Restrict)
  skill         Skill?   @relation(fields: [skillId, themeId], references: [id, themeId], onDelete: Restrict)
  createdBy     User     @relation("QuestionVersionAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  options       QuestionOption[]
  media         QuestionMedia[]
  submissions   QuestionSubmission[]
  publishedCopies Question[] @relation("PublishedVersionSource")
  publicationSubmissions QuestionSubmission[] @relation("SubmissionPublishedVersion")
  activitySelections ActivityQuestionVersion[]
  gameChallenges GameChallenge[]

  @@unique([questionId, versionNumber])
  @@index([grade, difficulty])
  @@index([themeId, skillId])
  @@index([contentHash])
}

model QuestionOption {
  id         String          @id @default(uuid()) @db.Uuid
  versionId  String          @db.Uuid
  stableId   String          @db.Uuid
  text       String          @db.VarChar(500)
  position   Int
  isCorrect  Boolean         @default(false)
  version    QuestionVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([versionId, stableId])
  @@unique([versionId, position])
  @@index([versionId, isCorrect])
}

model QuestionMedia {
  id          String            @id @default(uuid()) @db.Uuid
  versionId   String            @db.Uuid
  kind        QuestionMediaKind @default(IMAGE)
  mimeType    String            @db.VarChar(80)
  byteSize    Int
  altText     String            @db.VarChar(300)
  contentHash String            @db.Char(64)
  bytes       Bytes             @db.ByteA
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  version     QuestionVersion   @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([versionId, kind])
  @@index([contentHash])
}

model QuestionSubmission {
  id                 String                   @id @default(uuid()) @db.Uuid
  sourceVersionId    String                   @unique @db.Uuid
  submitterId        String                   @db.Uuid
  status             QuestionSubmissionStatus @default(SUBMITTED)
  revision           Int                      @default(1)
  reviewerId         String?                  @db.Uuid
  decisionNote       String?                  @db.VarChar(1000)
  publishedQuestionId String?                 @unique @db.Uuid
  publishedVersionId String?                  @unique @db.Uuid
  submittedAt        DateTime                 @default(now()) @db.Timestamptz(3)
  reviewStartedAt    DateTime?                @db.Timestamptz(3)
  decidedAt          DateTime?                @db.Timestamptz(3)
  sourceVersion      QuestionVersion          @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  submitter           User                     @relation("QuestionSubmitter", fields: [submitterId], references: [id], onDelete: Restrict)
  reviewer            User?                    @relation("QuestionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  publishedQuestion  Question?                 @relation("SubmissionPublishedQuestion", fields: [publishedQuestionId], references: [id], onDelete: Restrict)
  publishedVersion   QuestionVersion?          @relation("SubmissionPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: Restrict)

  @@index([status, submittedAt])
  @@index([submitterId, submittedAt])
  @@index([reviewerId, decidedAt])
}

model Activity {
  id            String         @id @default(uuid()) @db.Uuid
  schoolId      String         @db.Uuid
  classId       String         @db.Uuid
  teacherId     String         @db.Uuid
  title         String         @db.VarChar(160)
  instructions  String?        @db.VarChar(1000)
  targetCount   Int
  status        ActivityStatus @default(DRAFT)
  revision      Int            @default(1)
  openedAt      DateTime?      @db.Timestamptz(3)
  closedAt      DateTime?      @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classGroup    ClassGroup     @relation(fields: [classId, schoolId], references: [id, schoolId], onDelete: Restrict)
  teacher       User           @relation("ActivityTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  questionVersions ActivityQuestionVersion[]
  participations ActivityParticipation[]

  @@index([teacherId, schoolId, status, createdAt])
  @@index([classId, status, openedAt])
}

model ActivityQuestionVersion {
  activityId       String @db.Uuid
  questionVersionId String @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  activity         Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  questionVersion  QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)

  @@id([activityId, questionVersionId])
  @@index([questionVersionId])
}

model ActivityParticipation {
  id               String   @id @default(uuid()) @db.Uuid
  activityId       String   @db.Uuid
  enrollmentId     String   @db.Uuid
  studentId        String   @db.Uuid
  acceptedAnswers  Int      @default(0)
  correctAnswers   Int      @default(0)
  incorrectAnswers Int      @default(0)
  extraAnswers     Int      @default(0)
  targetReachedAt  DateTime? @db.Timestamptz(3)
  revision         Int      @default(1)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  activity         Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  enrollment       Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  student          User @relation("ActivityStudent", fields: [studentId], references: [id], onDelete: Restrict)
  answerReceipts   ActivityAnswerReceipt[]
  gameSessions     GameSession[]

  @@unique([activityId, studentId])
  @@index([studentId, createdAt])
  @@index([enrollmentId])
}

model ActivityAnswerReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  participationId String   @db.Uuid
  clientActionId  String   @db.Uuid
  outcome         AcceptedAnswerOutcome
  acceptedNumber  Int
  isExtra         Boolean
  acceptedAt      DateTime @default(now()) @db.Timestamptz(3)
  participation   ActivityParticipation @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@unique([participationId, clientActionId])
  @@index([participationId, acceptedAt])
}

model GameSession {
  id                    String            @id @default(uuid()) @db.Uuid
  participationId       String            @db.Uuid
  status                GameSessionStatus @default(ACTIVE)
  phase                 GamePhase         @default(WAITING_FIRST_EXIT)
  turn                  GameTurn          @default(STUDENT)
  boardVersion          String            @db.VarChar(80)
  rules                 Json              @db.JsonB
  pieces                Json              @db.JsonB
  revision              Int               @default(1)
  errorCount            Int               @default(0)
  lastQuestionVersionId String?           @db.Uuid
  startedAt             DateTime          @default(now()) @db.Timestamptz(3)
  suspendedAt           DateTime?         @db.Timestamptz(3)
  finishedAt            DateTime?         @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)
  participation         ActivityParticipation @relation(fields: [participationId], references: [id], onDelete: Restrict)
  actions               GameAction[]
  challenges            GameChallenge[]

  @@index([participationId, status, startedAt])
  @@index([status, updatedAt])
}

model GameAction {
  id               String         @id @default(uuid()) @db.Uuid
  gameId           String         @db.Uuid
  clientActionId   String         @db.Uuid
  type             GameActionType
  expectedRevision Int
  result           Json           @db.JsonB
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  game             GameSession    @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@unique([gameId, clientActionId])
  @@index([gameId, createdAt])
}

model GameChallenge {
  id                String          @id @default(uuid()) @db.Uuid
  gameId            String          @db.Uuid
  questionVersionId String          @db.Uuid
  difficulty        Int
  dice              Int
  status            ChallengeStatus @default(PENDING)
  isRepeated        Boolean         @default(false)
  sessionRevision   Int
  presentedAt       DateTime        @default(now()) @db.Timestamptz(3)
  answeredAt        DateTime?       @db.Timestamptz(3)
  game              GameSession     @relation(fields: [gameId], references: [id], onDelete: Restrict)
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)

  @@index([gameId, presentedAt])
  @@index([questionVersionId])
}
